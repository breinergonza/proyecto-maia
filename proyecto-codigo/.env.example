# Copie este archivo a .env (cp .env.example .env) y cambie todo lo que dice "cambiar".
# .env nunca se sube a git ni a Railway (está en .gitignore y .railwayignore).

# --- Comunes ---
MAIA_ENTORNO=local                 # local | demo (Railway) | produccion (on-premise, ver infra/on-premise)
DATABASE_URL=postgresql+psycopg://maia:cambiar@postgres:5432/maia
MAIA_RAIZ=/datos                   # entradas/, salidas/ e interno/ del núcleo, dentro del contenedor
MAIA_PAQUETE_CLAVE=cambiar         # HMAC de los paquetes de modelos; la misma en local y en Railway
MAIA_CIFRADO_CLAVE=                # 32+ caracteres (openssl rand -hex 32): cifra la clave de la base de la entidad que
                                   # se guarda en Administración › Configuración. Vacía: no se guardan claves desde la web
MAIA_ZONA_HORARIA=America/Bogota   # zona de las ejecuciones programadas

# --- Solo local ---
# KMC_PW no va aquí: expórtela solo en la terminal antes de la corrida (export KMC_PW=...); nunca en archivos ni en Railway
# Base de origen de la Fundación (solo lectura, ver docs/extraccion.md). Servidor y usuario los entrega el
# Observatorio; también se pueden guardar en Administración › Configuración en lugar de aquí.
KMC_HOST=
# KMC_PORT=5432
# KMC_DB=postgres
KMC_USUARIO=
# KMC_ESQUEMA=consumo
# KMC_SSLMODE=require                # disable solo para un Postgres de prueba local
# KMC_TIMEOUT=20                     # segundos para conectar
MAIA_LGBM_DEVICE=cuda              # cuda | cpu
POSTGRES_PASSWORD=cambiar          # la misma que va en DATABASE_URL; solo letras y números (openssl rand -hex 24)
MLFLOW_DB_PASSWORD=cambiar
MLFLOW_TRACKING_URI=http://mlflow:5000
# Autenticación nativa de MLflow: el admin se crea con estos datos en el primer arranque y lo usan trainer, programador
# y API. También es el ingreso a la interfaz (http://localhost:5000). Clave de 12+ caracteres: openssl rand -hex 16
MLFLOW_TRACKING_USERNAME=admin
MLFLOW_TRACKING_PASSWORD=cambiar_minimo_12
MLFLOW_FLASK_SERVER_SECRET_KEY=cambiar     # openssl rand -hex 32
MLFLOW_URL_PUBLICA=http://localhost:5000   # enlace a MLflow que muestra Administración › Entrenamientos
MINIO_ROOT_USER=maia
MINIO_ROOT_PASSWORD=cambiar_minimo_8
MINIO_URL=http://minio:9000
# minio/minio y minio/mc ya no se publican en Docker Hub: defina una fuente aprobada (vacías = etiquetas originales)
MINIO_IMAGEN=minio/minio:RELEASE.2025-09-07T16-13-09Z
MC_IMAGEN=minio/mc:RELEASE.2025-08-13T08-35-41Z
MINIO_ACCESS_KEY=maia-servicio
MINIO_SECRET_KEY=cambiar_minimo_8
MLFLOW_MINIO_ACCESS_KEY=maia-mlflow
MLFLOW_MINIO_SECRET_KEY=cambiar_minimo_8

# --- API ---
MAIA_JWT_SECRETO=cambiar_por_64_caracteres
MAIA_JWT_MINUTOS=30
MAIA_REFRESCO_DIAS=7
MAIA_ADMIN_EMAIL=b.gonzalez@uniandes.edu.co
MAIA_ADMIN_CLAVE=cambiar           # 12 caracteres o más fuera de MAIA_ENTORNO=local (docker-compose.app.yml usa demo)
MAIA_SOLO_SIMULADO=false           # true en Railway
MAIA_DIR_PAQUETES=/datos/paquetes
MAIA_DEMO_SUJETOS=3000
MAIA_URL_PUBLICA=http://localhost:8080

# --- Correo (en local, Mailpit: http://localhost:8025) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=alertas@maia.local
SMTP_TLS=false
