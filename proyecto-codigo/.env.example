# Copie este archivo a .env (cp .env.example .env) y cambie todo lo que dice "cambiar".
# .env nunca se sube a git ni a Railway (está en .gitignore y .railwayignore).

# --- Comunes ---
MAIA_ENTORNO=local                 # local | demo (Railway)
DATABASE_URL=postgresql+psycopg://maia:cambiar@postgres:5432/maia
MAIA_RAIZ=/datos                   # entradas/, salidas/ e interno/ del núcleo, dentro del contenedor
MAIA_PAQUETE_CLAVE=cambiar         # HMAC de los paquetes de modelos; la misma en local y en Railway

# --- Solo local ---
# KMC_PW no va aquí: expórtela solo en la terminal antes de la corrida (export KMC_PW=...); nunca en archivos ni en Railway
MAIA_LGBM_DEVICE=cuda              # cuda | cpu
POSTGRES_PASSWORD=cambiar          # la misma que va en DATABASE_URL
MLFLOW_DB_PASSWORD=cambiar
MLFLOW_TRACKING_URI=http://mlflow:5000
MINIO_ROOT_USER=maia
MINIO_ROOT_PASSWORD=cambiar_minimo_8
MINIO_URL=http://minio:9000
MINIO_ACCESS_KEY=maia-servicio
MINIO_SECRET_KEY=cambiar_minimo_8
MLFLOW_MINIO_ACCESS_KEY=maia-mlflow
MLFLOW_MINIO_SECRET_KEY=cambiar_minimo_8

# --- API ---
MAIA_JWT_SECRETO=cambiar_por_64_caracteres
MAIA_JWT_MINUTOS=30
MAIA_REFRESCO_DIAS=7
MAIA_ADMIN_EMAIL=b.gonzalez@uniandes.edu.co
MAIA_ADMIN_CLAVE=cambiar
MAIA_SOLO_SIMULADO=false           # true en Railway
MAIA_DIR_PAQUETES=/datos/paquetes
MAIA_DEMO_SUJETOS=3000
MAIA_URL_PUBLICA=http://localhost:8080

# --- Correo (en local, Mailpit: http://localhost:8025) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=alertas@maia.local
SMTP_TLS=false
