+@pytest.fixture
+def base_falsa(monkeypatch, meta, ancha):
+    """The KMC database replaced by the simulated base, with a declaration of restricted fields."""
+    restringidas: set[str] = set()
+
+    class Conexion:
+        def __enter__(self):
