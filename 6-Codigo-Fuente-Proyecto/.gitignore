# Protección por si alguien hace commit: nada de secretos, datos, modelos ni dependencias.
.env
.env.*
!.env.example
.venv/
node_modules/
dist/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
respaldos/
datos/
mlruns/
*.parquet
# salvo las tablas esperadas de las pruebas del núcleo: 60 niños simulados (p0…p59), sin datos reales
!nucleo/pruebas/esperado_kmc/*.parquet
*.pkl
*.tar.gz
*.xlsx
!nucleo/entradas/diccionario.xlsx
nucleo/salidas/
nucleo/interno/
nucleo/cortes/
nucleo/paquetes/
nucleo/privado/
nucleo/entradas/retroalimentacion/
.DS_Store
~$*
